# ---- WhatsApp Cloud API (Meta) ----
# Token que vos elegís; debe coincidir con el que cargás en el panel de Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=claridad-total-verify
# Token de acceso de la app de Meta (System User token, de larga duración en producción).
WHATSAPP_ACCESS_TOKEN=
# ID del número de teléfono de la WABA (Phone Number ID), lo da el panel de WhatsApp.
WHATSAPP_PHONE_NUMBER_ID=
# ID de la WhatsApp Business Account (WABA), para webhooks y plantillas.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Versión del Graph API.
GRAPH_API_VERSION=v21.0
# Idioma de las plantillas de mensaje.
TEMPLATE_LANG=es_AR

# ---- Claude ----
ANTHROPIC_API_KEY=
# Modelo del agente. Sonnet 5 equilibra calidad/costo; para máximo ahorro: claude-haiku-4-5-20251001
AGENT_MODEL=claude-sonnet-5

# ---- Negocio ----
# Número (formato internacional, ej. 5492610000000) al que se avisan visitas/handoffs. Opcional.
CORREDOR_NOTIFY_NUMBER=

# ---- Despliegue (solo servidor propio con Docker + Caddy) ----
# Subdominio que apunta a este servidor; Caddy le saca el HTTPS. Ej: bot.tudominio.com
AGENT_DOMAIN=

# ---- MercadoLibre (datos de oferta reales) ----
# App gratuita en developers.mercadolibre.com.ar. Con estas dos alcanza (client_credentials).
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# Alternativa: un token manual si preferís no usar client_credentials.
MELI_ACCESS_TOKEN=
